@prefix : <http://thefirm.com/graphix#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://thefirm.com/graphix> a owl:Ontology ;
    rdfs:comment "RDF/OWL ontology mapping all SDLC stages for threat modeling, controls assessments and asset management." .

#################################################################
#    Classes (Taxonomy)
#################################################################

### Base Architecture Elements ###

:Graphix_Element a owl:Class .

:Graphix_TrustBoundary a owl:Class ;
    rdfs:subClassOf :Graphix_Element ;
    rdfs:comment "Defines the boundary of trust between entities." .

### Level 1 (Context) Classes ###

:L1_Element a owl:Class ;
    rdfs:subClassOf :Graphix_Element .

:L1_Actor a owl:Class ;
    rdfs:subClassOf :L1_Element .

:L1_SoftwareSystem a owl:Class ;
    rdfs:subClassOf :L1_Element .

:L1_ExternalSystem a owl:Class ;
    rdfs:subClassOf :L1_SoftwareSystem ;
    owl:disjointWith :L1_InternalSystem ;
    rdfs:comment "Systems outside the modeled system's perimeter." .

:L1_InternalSystem a owl:Class ;
    rdfs:subClassOf :L1_SoftwareSystem ;
    rdfs:comment "Systems built and maintained within the modeled system's perimeter." .

:L1_InternalSystemPerimeter a owl:Class ;
    rdfs:subClassOf :Graphix_TrustBoundary ;
    rdfs:comment "Defines the security perimeter of an internal system." .

:L1_Interface a owl:Class ;
    rdfs:subClassOf :L1_Element ;
    rdfs:comment "Defines an interface through which systems communicate." .

### Level 2 (Container) Classes ###

:L2_Element a owl:Class ;
    rdfs:subClassOf :Graphix_Element .

:L2_Container a owl:Class ;
    rdfs:subClassOf :L2_Element .

:L2_WebService a owl:Class ;
    rdfs:subClassOf :L2_Container .

:L2_ComputeEngine a owl:Class ;
    rdfs:subClassOf :L2_Container .

:L2_DataStore a owl:Class ;
    rdfs:subClassOf :L2_Container .

:L2_API a owl:Class ;
    rdfs:subClassOf :L2_Element ;
    rdfs:comment "Defines an API to a Container." .

:L2_TrustBoundary a owl:Class ;
    rdfs:subClassOf :L2_Element ;
    rdfs:comment "Defines the boundary around a set of related containers." .

#################################################################
#    Object Properties (Relationships)
#################################################################

### L1 Level Relationships ###

:L1_invokesInterface a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (:L1_Actor :L1_InternalSystem) ];
    rdfs:range :L1_Interface ;
    rdfs:comment "Internal System invoking an interface exposed by another system." .

:L1_exposesInterface a owl:ObjectProperty ;
    rdfs:domain :L1_SoftwareSystem ;
    rdfs:range :L1_Interface ;
    rdfs:comment "Defines an interface exposed by a system." .

:L1_insidePerimeter a owl:ObjectProperty ;
    rdfs:domain :L1_InternalSystem ;
    rdfs:range :L1_InternalSystemPerimeter ;
    rdfs:comment "Indicates that an internal system is within a specific trust boundary." .

### L2 Level Relationships ###

:L2_insideTrustBoundary a owl:ObjectProperty ;
    rdfs:domain :L2_Container ;
    rdfs:range :L2_TrustBoundary ;
    rdfs:comment "Indicates that a container is within a specific zone." .

:L2_invokesAPI a owl:ObjectProperty ;
    rdfs:domain :L2_Container ;
    rdfs:range :L2_API ;
    rdfs:comment "Containers invoking API." .

:L2_exposesAPI a owl:ObjectProperty ;
    rdfs:domain :L2_Container ;
    rdfs:range :L2_API ;
    rdfs:comment "Defines an API exposed by a container." .

### Cross-Level Relationships

:L2_container_to_L1 a owl:ObjectProperty ;
    rdfs:domain :L2_Container ;
    rdfs:range :L1_InternalSystem ;
    rdfs:comment "Maps a specific L2 Container to its parent L1 Internal Software System." .

:L2_API_to_L1 a owl:ObjectProperty ;
    rdfs:domain :L2_API ;
    rdfs:range :L1_Interface ;
    rdfs:comment "Maps an L2 API to the L1 Interface it implements." .

:L2_trustBoundary_to_L1 a owl:ObjectProperty ;
    rdfs:domain :L2_TrustBoundary ;
    rdfs:range :L1_InternalSystemPerimeter ;
    rdfs:comment "Maps an L2 Zone to its parent L1 Trust Boundary." .

