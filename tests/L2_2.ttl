@prefix : <http://thefirm.com/graphix#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#    L2 E-Commerce Platform Example Fixes
#################################################################

:L2_ProductDatabase :L2_insideTrustBoundary :L2_ApplicationZone .
:L2_ProductDatabase :L2_container_to_L1 :L1_ECommercePlatform .
:L2_ApplicationZone :L2_trustBoundary_to_L1 :L1_InternalSystemPerimeter .
:L2_NotificationServiceInterface a :L2_Interface ;
    rdfs:label "Notification Service Interface" .
:L2_NotificationServiceInterface :L2_Interface_to_L1 :L1_NotificationInterface .
:L2_ProcessingEngine :L2_invokesInterface :L2_NotificationServiceInterface .

# --- Control mitigations (confirmed at L3) ---
# The edge gateway's remaining capable-only controls are confirmed configured,
# and the product database now encrypts at rest -- so every obligation is met.
:L2_EdgeGateway :providesControl :TrafficEncryption , :ClientAuthentication .
:L2_ProductDatabase :providesControl :EncryptionAtRest , :AccessControl .
