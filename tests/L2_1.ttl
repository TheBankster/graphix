@prefix : <http://thefirm.com/graphix#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#    L2 E-Commerce Platform Example
#################################################################

# --- Actors ---
:L2_Customer a :L2_Actor ;
    rdfs:label "E-Commerce Platform Customer" .

# --- Containers ---
:L2_WebFrontEnd a :L2_WebService ;
    rdfs:label "Web Front-End" .

:L2_ProcessingEngine a :L2_ComputeEngine ;
    rdfs:label "E-Commerce Platform Processing Engine" .

:L2_ProductDatabase a :L2_DataStore ;
    rdfs:label "E-Commerce Platform Product Database" .

# --- Interfaces ---
:L2_WebFrontEndInterface a :L2_Interface ;
    rdfs:label "Web Front-End Interface" .

:L2_ProcessingEngineInterface a :L2_Interface ;
    rdfs:label "E-Commerce Processing Engine Interface" .

:L2_ProductDatabaseInterface a :L2_Interface ;
    rdfs:label "E-Commerce Product Database Interface" .

:L2_PaymentGatewayInterface a :L2_Interface ;
    rdfs:label "Payment Gateway Interface" .

# Deliberately Missing
#:L2_NotificationServiceInterface a :L2_Interface ;
#    rdfs:label "Notification Service Interface" .

# --- Trust Boundaries ---
:L2_WebFrontEndZone a :L2_TrustBoundary , :PublicZone ;
    rdfs:label "Trust boundary around the web front end" .

:L2_ApplicationZone a :L2_TrustBoundary , :ApplicationZone ;
    rdfs:label "Trust boundary around the processing engine" .

# Links to Trust Boundaries
:L2_WebFrontEnd :L2_insideTrustBoundary :L2_WebFrontEndZone.

:L2_ProcessingEngine :L2_insideTrustBoundary :L2_ApplicationZone .

# Deliberately Missing
#:L2_ProductDatabase :L2_insideTrustBoundary :L2_ApplicationZone .

# --- L2 to L1 Links ---
:L2_WebFrontEnd :L2_container_to_L1 :L1_ECommercePlatform .

:L2_ProcessingEngine :L2_container_to_L1 :L1_ECommercePlatform .

# Deliberately Missing
#:L2_ProductDatabase :L2_container_to_L1 :L1_ECommercePlatform .

:L2_WebFrontEndZone :L2_trustBoundary_to_L1 :L1_InternalSystemPerimeter .

# Deliberately Missing
#:L2_ApplicationZone :L2_trustBoundary_to_L1 :L1_InternalSystemPerimeter .

# --- Interface to L1 Links ---
:L2_WebFrontEndInterface :L2_Interface_to_L1 :L1_ECommerceInterface .

:L2_PaymentGatewayInterface :L2_Interface_to_L1 :L1_PaymentInterface .

# Deliberately missing
#:L2_NotificationServiceInterface :L2_Interface_to_L1 :L1_NotificationInterface .

# --- Interface exposures and invocations ---
:L2_Customer :L2_invokesInterface :L2_WebFrontEndInterface .

:L2_WebFrontEnd :L2_exposesInterface :L2_WebFrontEndInterface .

:L2_ProcessingEngine :L2_exposesInterface :L2_ProcessingEngineInterface .

:L2_ProductDatabase :L2_exposesInterface :L2_ProductDatabaseInterface .

:L2_WebFrontEnd :L2_invokesInterface :L2_ProcessingEngineInterface .

:L2_ProcessingEngine :L2_invokesInterface :L2_ProductDatabaseInterface .

:L2_ProcessingEngine :L2_invokesInterface :L2_PaymentGatewayInterface .

# Deliberately missing
#:L2_ProcessingEngine :L2_invokesInterface :L2_NotificationServiceInterface .

# --- Control providers & obligations (L2) ---

# A managed API gateway sits in front of the public web interface. As an
# :APIGatewayContainer it is (under inference) capableOfControl Rate Limiting,
# Client Authentication and Traffic Encryption -- but "capable" only, until
# confirmed. We simulate one L3-confirmed control (Rate Limiting); the others
# stay capable-only, so the satisfaction check reports them Potential.
:L2_EdgeGateway a :APIGatewayContainer ;
    rdfs:label "Public edge API gateway" .
:L2_EdgeGateway :L2_insideTrustBoundary :L2_WebFrontEndZone .
:L2_EdgeGateway :L2_container_to_L1 :L1_ECommercePlatform .
:L2_EdgeGateway :protects :L2_WebFrontEndInterface .
:L2_EdgeGateway :providesControl :RateLimiting .   # simulated L3-confirmed config

# Node-control obligations are DERIVED from data sensitivity (see schema
# :DataProtectionPolicy): the product database handles confidential data, so the
# control modeler derives :requiresControl EncryptionAtRest + AccessControl on it.
# No provider in L2_1 -> the satisfaction check reports these Open.
:L2_ProductDatabase :handlesDataOfSensitivity :Confidential .
