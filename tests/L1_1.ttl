@prefix : <http://thefirm.com/graphix#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#    L1 E-Commerce Platform Example
################################################################

# --- Actors ---
:L1_Customer a :L1_Actor ;
    rdfs:label "E-Commerce Platform Customer" .

# --- Software Systems ---
:L1_ECommercePlatform a :L1_InternalSystem ;
    rdfs:label "E-Commerce Platform" .

:L1_PaymentGateway a :L1_ExternalSystem ;
    rdfs:label "Payment Gateway" .

:L1_NotificationService a :L1_ExternalSystem ;
    rdfs:label "Notification Service" .

# --- Interfaces ---
:L1_ECommerceInterface a :L1_Interface ;
    rdfs:label "E-Commerce Platform Interface" .

:L1_PaymentInterface a :L1_Interface ;
    rdfs:label "Payment Gateway Interface" .

:L1_NotificationInterface a :L1_Interface ;
    rdfs:label "Notification Service Interface" .

# --- Trust Boundaries ---
:L1_PlatformBoundary a :L1_TrustBoundary ;
    rdfs:label "E-Commerce Platform Trust Boundary" .

# --- Interface exposures and invocations ---
:L1_Customer :L1_invokesInterface :L1_ECommerceInterface .

:L1_ECommercePlatform :L1_exposesInterface :L1_ECommerceInterface .

:L1_ECommercePlatform :L1_invokesInterface :L1_NotificationInterface .

:L1_PaymentGateway :L1_exposesInterface :L1_PaymentInterface .

# --- Deliberately missing
# 1. L1_NotificationService is not exposing any interface
# 2. L1_EcommercePlatform is not inside any trust boundary
# 3. L1_PaymentGateway's interface is not invoked by any system
